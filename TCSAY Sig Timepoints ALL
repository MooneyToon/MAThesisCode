import matplotlib.pyplot as plt
import numpy as np

# Group the layers into subsets for separate plots
layer_groups = {
    'Group 1': list(total_significant_timepoints.keys())[:29],
    'Group 2': list(total_significant_timepoints.keys())[29:61],
    'Group 3': list(total_significant_timepoints.keys())[61:107],
    'Group 4': list(total_significant_timepoints.keys())[107:]
}

# Plot each group
for group_name, layers in layer_groups.items():
    # Extract the total significant time points for the current group
    counts = [total_significant_timepoints[layer] for layer in layers if layer in total_significant_timepoints]

    # Plot the data
    plt.figure(figsize=(10, 6))
    plt.plot(layers, counts, marker='o', linestyle='-', label='Significant Time Points')

    # Customize the plot
    plt.xticks(rotation=90)  # Rotate x-axis labels for better visibility
    plt.xlabel('Layers', fontsize=14)
    plt.ylabel('Total Significant Time Points', fontsize=14)
    plt.title(f'Total Significant Time Points ({group_name})', fontsize=16)
    plt.grid(True, axis='y')  # Add a grid to the y-axis for better visualization

    # Add padding to avoid overlapping of axis and text
    plt.tight_layout()

    # Show the plot
    plt.show()

