from sklearn.metrics.pairwise import cosine_similarity
import numpy as np

# Step 1: Make sure your features are in a consistent flattened form
# This flattens each feature array into a 1D vector
all_feature_vectors = []
labels = []

for key, feature in features_dict.items():
    flattened = feature.flatten()  # flatten to 1D
    all_feature_vectors.append(flattened)
    labels.append(key)

# Step 2: Stack into a 2D array (shape: [16, N])
all_feature_vectors = np.stack(all_feature_vectors)

# Step 3: Compute cosine similarity matrix
similarity_matrix = cosine_similarity(all_feature_vectors)

VGG19 = np.array(1-similarity_matrix)

