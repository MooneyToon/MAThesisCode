# Import necessary libraries
import torch
from multimodal.multimodal_lit import MultiModalLitModel
from torchvision import transforms, datasets
from torch.utils.data import DataLoader
import mne.stats as mstats
import numpy as np
from scipy.io import loadmat
from scipy.stats import spearmanr


# Set the device (GPU if available, otherwise CPU)
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# Load the CVCL model
cvcl, preprocess = MultiModalLitModel.load_model(model_name="cvcl")
cvcl = cvcl.to(device)
cvcl.eval()

# Define preprocessing for the dataset
preprocess = transforms.Compose([
    transforms.Resize(256),
    transforms.CenterCrop(224),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
])

# Load the dataset and dataloader
image_data_path = "/content/drive/My Drive/Colab Notebooks/original visual stimuli"
dataset = datasets.ImageFolder(root=image_data_path, transform=preprocess)
dataloader = DataLoader(dataset, batch_size=16, shuffle=False, num_workers=2)  # Adjust batch size if needed

# Process the dataset through the model
for batch_idx, (images, labels) in enumerate(dataloader):  # labels are unused
    images = images.to(device)  # Move images to the appropriate device

    # Encode the batch of images using the model
    image_features = cvcl.encode_image(images)

    # Print results for each batch
    print(f"Batch {batch_idx + 1}:")
    print("Image Features Shape:", image_features.shape)
    print("Image Features (First 5):", image_features[:5])  # Display a few features for inspection

    # Optional: Stop after one batch for testing
    break
################################################################################
from sklearn.metrics.pairwise import cosine_similarity

# Move to CPU and convert to NumPy array
image_features_np = image_features.detach().cpu().numpy()

# Calculate cosine similarity matrix for images
similarity_matrix_images = cosine_similarity(image_features_np)

print("Image Similarity Matrix:")
print(similarity_matrix_images)

#######################################
import matplotlib.pyplot as plt
# Create the Representational Dissimilarity Matrix (RDM)
CVCL_model = 1 - similarity_matrix_images  # Convert similarity to dissimilarity

# Plot RDM with title, axes titles, and colorbar
plt.imshow(CVCL_model, cmap="viridis")  # You can use different colormaps (e.g., 'hot', 'cool', etc.)
plt.colorbar()
plt.title('Representational Dissimilarity Matrix (RDM)', fontsize=18)
plt.ylabel('Images', fontsize=16)
plt.xlabel('Compared Images', fontsize=16)
plt.show()

# turning the 16x16 RDM into a list of 120 values
#rdm indices is a list of x and y values
rdm_indices = np.triu_indices(16)
cor_rdm = []
for i in range(0,len(rdm_indices[0])):
#pulls out x and y values, (index at 0)
    x = rdm_indices[0][i]
    y = rdm_indices[1][i]
#skipping diagnol
    if x==y:
        continue
 #appending values selected at x and y to RDM List
    cor_rdm.append(CVCL_model[x,y])
