# Extract features from different layers of the model
def get_feature_vectors(model, dataloader, layer_name):
    feature_vectors = []

    # Hook function to extract features
    def hook_fn(module, input, output):
        feature_vectors.append(output.detach().cpu().numpy())

    # Register the hook
    layer = dict(model.named_modules())[layer_name]
    handle = layer.register_forward_hook(hook_fn)

    # Pass the data through the model
    for inputs, labels in dataloader:
        inputs = inputs.to(device)  # Move inputs to the same device as the model
        model(inputs)

    # Remove the hook
    handle.remove()

    # Concatenate all feature vectors and reshape if necessary
    feature_vectors = np.concatenate(feature_vectors, axis=0)

    # Flatten the feature vectors if they are more than 2D
    if feature_vectors.ndim > 2:
        num_samples = feature_vectors.shape[0]
        flattened_features = feature_vectors.reshape(num_samples, -1)
    else:
        flattened_features = feature_vectors

    return flattened_features


