for i, layer_name in enumerate(layer_names):
    # Iterate through each cluster for the current layer
    for i_c, (start, stop) in enumerate(cleaned_clusters_dict[layer_name]):
        p_value = cluster_p_values_dict[layer_name][i_c]

        # Assign color based on p-value thresholds
        if p_value <= 0.001:
            color = 'green'
        elif p_value <= 0.01:
            color = 'blue'
        elif p_value <= 0.05:
            color = 'red'
        else:
            continue  # Skip if p_value > 0.05 (not significant)

        # Plot the vertical lines for the significant cluster
        plt.vlines(x=times[start:stop], ymin=i - 0.4, ymax=i + 0.4,
                   color=color, alpha=0.5)

