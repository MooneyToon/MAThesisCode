import numpy as np
from mne.stats import permutation_cluster_test as pcluster_test

# Initialize dictionaries to store the cluster p-values and clusters for each layer
cluster_p_values_dict = {}
clusters_dict = {}

# Loop through each key in rvalues_dict
for layer_name, rvalues in rvalues_dict.items():
    print(f"Running permutation cluster test for {layer_name}...")

    # Making a list of zeros to compare R values to
    b = np.full([np.shape(DA)[0], epoch], 0)

    # Running the permutation cluster test
    T_obs, clusters, cluster_p_values, H0 = pcluster_test([np.array(rvalues), b], tail=1, out_type="mask")

    # Store the cluster p-values and clusters in their respective dictionaries
    cluster_p_values_dict[layer_name] = cluster_p_values
    clusters_dict[layer_name] = clusters

    # Optionally count the number of significant clusters
    significance_threshold = 0.05
    num_significant_clusters = np.sum(cluster_p_values <= significance_threshold)

    print(f"Number of significant clusters for {layer_name}: {num_significant_clusters}")

# The cluster_p_values_dict now contains the cluster p-values for each layer
# The clusters_dict now contains the clusters for each layer

print(cluster_p_values_dict)
###############################################################################
# Initialize a new dictionary to store the results
cleaned_clusters_dict = {}

# Iterate through each key and value in the original clusters_dict
for layer_name, clusters in clusters_dict.items():
    # Initialize a list to store the cleaned cluster data
    cleaned_clusters = []

    # Iterate through each cluster (which contains a slice)
    for cluster in clusters:
        cluster_slice = cluster[0]  # Get the slice object (first element in the tuple)
        # Extract the start and stop from the slice and append as a tuple
        cleaned_clusters.append((cluster_slice.start, cluster_slice.stop))

    # Store the cleaned clusters in the new dictionary
    cleaned_clusters_dict[layer_name] = cleaned_clusters

# Now cleaned_clusters_dict contains the desired structure

print(cleaned_clusters_dict)
